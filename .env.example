# Copy to .env for local development. Never commit real values.
APP_ENV=local
APP_NAME=Jolly
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Bolna voice layer — https://platform.bolna.ai
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
# UUID of the Jolly agent you created in the Bolna dashboard
BOLNA_AGENT_ID=
# Optional: a number bought in your Bolna account (E.164). Omit to use the default.
BOLNA_FROM_NUMBER=
# Shared secret for Bolna tool calls, webhooks and the morning-call trigger.
# Send it as the X-Jolly-Secret header (preferred) or ?secret=... (legacy URLs).
# REQUIRED unless APP_ENV is local or test: without it those routes return 503.
BOLNA_WEBHOOK_SECRET=

# Trust layer
# HMAC key for signed, expiring, single-use approval links (falls back to BOLNA_WEBHOOK_SECRET)
APPROVAL_SECRET=
# Approval token lifetime in seconds (default 24 h)
APPROVAL_TTL_SECONDS=86400
# Put the approval token in GET /updates payloads so the console can approve (demo). Set false to lock down.
APPROVAL_TOKEN_IN_PAYLOAD=true
# Pepper for HMAC-ing phone numbers in the audit log (falls back to APPROVAL_SECRET / BOLNA_WEBHOOK_SECRET)
AUDIT_PEPPER=

# Case store: SQLite file by default; set a Postgres URL in production
DATABASE_URL=sqlite:///./jolly.db
# Load the three synthetic demo matters into an empty database on startup
SEED_DEMO_DATA=true

# Gemini free tier key from https://aistudio.google.com/apikey (no billing needed).
# Without a key Jolly still works: offline embeddings + extractive, cited answers.
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Defaults to LLM_API_KEY when empty
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
